{
    "version": 2,
    "builds": [
      {
        "src": "build_files.sh",
        "use": "@vercel/python",
        "config": { "maxLambdaSize": "15mb", "runtime": "python3" }
      },
      {
        "src": "core/wsgi.py",
        "use": "@vercel/python",
        "config": { "maxLambdaSize": "15mb", "runtime": "python3" }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "core/wsgi.py"
      }
    ],
    "env": {
      "DJANGO_SETTINGS_MODULE": "core.settings"
    }
}