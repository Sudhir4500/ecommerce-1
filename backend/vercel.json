{
    "version": 2,
    "builds": [
      {
        "src": "core/wsgi.py",
        "use": "@vercel/python",
        "config": { "maxLambdaSize": "15mb", "runtime": "python3" }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "core/wsgi.py"
      }
    ],
    "env": {
      "DJANGO_SETTINGS_MODULE": "core.settings",
      "SECRET_KEY": "your-secret-key",
      "DEBUG": "False",
      "ALLOWED_HOSTS": ".vercel.app"
    }
  }